/** Reply intent classification and routing decisions. */
function classifyReply_(subject,body,headers,fromEmail){var text=(String(subject||'')+'\n'+String(body||'')).toLowerCase();var autoSubmitted=safeString_(headers&&headers['auto-submitted']).toLowerCase();var precedence=safeString_(headers&&headers.precedence).toLowerCase();var from=normalizeEmail_(fromEmail||(headers&&headers.from));var result={primary:'Needs Human Review',hiringNow:false,futureHiring:false,entryLevel:/entry[ -]?level|recent graduate|new graduate|will train|training provided|no experience/.test(text),internship:/intern(ship)?|student placement|summer student/.test(text),apprenticeship:/apprentice(ship)?|work[- ]based learning|co-?op/.test(text),isAutomatic:false,isBounce:false};if(/mailer-daemon|postmaster/.test(from)||/delivery status notification|undeliverable|address not found|message not delivered|550\s+5\.1\.1|recipient address rejected/.test(text)){result.primary='Bounce';result.isAutomatic=true;result.isBounce=true;return result;}if(detectUnsubscribe_(text)){result.primary='Unsubscribe';return result;}if(autoSubmitted||/auto[- ]?reply|automatic reply|out of office|away from (the )?office|vacation response/.test(text)||precedence==='bulk'){result.primary=/out of office|away from (the )?office|vacation/.test(text)?'Out of Office':'Automatic Reply';result.isAutomatic=true;return result;}if(/wrong (person|contact|department)|no longer works here|not the right contact|contact .* instead|forwarded.*to/.test(text)){result.primary='Referred to Another Contact';return result;}if(/not interested|no thank you|we do not use welders|not a fit/.test(text)){result.primary='Not Interested';return result;}if(/not currently hiring|not hiring (right now|at this time)|no openings|positions? (are )?filled/.test(text)){result.primary='Not Currently Hiring';return result;}result.hiringNow=/currently hiring|hiring now|\b(?:we|our company|the company)?\s*(?:are|is)\s+hiring\b|\bhiring\s+(?:\d+|one|two|three|four|five|several)\b|immediate(ly)?|open positions?|looking (for|to hire)|need\s+(?:\d+|one|two|three|four|five|several)|send (us )?resumes|accepting applications/.test(text);result.futureHiring=/future hiring|expect(ing)? to hire|may need|will need|later this year|next year|next quarter|in the next|upcoming hiring/.test(text);if(result.hiringNow)result.primary='Hiring Now';else if(result.futureHiring)result.primary='Future Hiring';else if(result.internship)result.primary='Internship Interest';else if(result.apprenticeship)result.primary='Apprenticeship Interest';else if(result.entryLevel)result.primary='Entry-Level Interest';else if(/more information|send (me|us) information|tell me more|interested in learning|call me|contact me/.test(text))result.primary='Wants Information';return result;}
function isPositiveClassification_(classification){return['Hiring Now','Future Hiring','Entry-Level Interest','Internship Interest','Apprenticeship Interest','Wants Information'].indexOf(classification)!==-1;}
function shouldCreateLead_(classification){return['Hiring Now','Future Hiring','Entry-Level Interest','Internship Interest','Apprenticeship Interest','Wants Information','Referred to Another Contact','Not Currently Hiring','Needs Human Review'].indexOf(classification)!==-1;}
function leadStageForClassification_(classification){var map={'Hiring Now':'Hiring Now','Future Hiring':'Future Hiring','Not Currently Hiring':'Nurture','Referred to Another Contact':'Contacted','Needs Human Review':'Needs Review'};return map[classification]||'New Reply';}
function calculateLeadScore_(classification,info){var score=classification.hiringNow?75:classification.futureHiring?60:45;if(info.entryLevelStatus==='Yes')score+=5;if(info.internshipStatus==='Yes')score+=5;if(info.apprenticeshipStatus==='Yes')score+=5;if(info.openings)score+=5;if(info.county)score+=5;if(info.phone||info.alternateEmail)score+=3;return Math.min(100,score);}
