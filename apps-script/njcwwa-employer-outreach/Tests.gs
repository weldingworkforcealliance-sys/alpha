/** Controlled test functions. None can send to a non-allowlisted address. */
function createTestQueueRecord(){assertAllianceAccount_();assertRequiredSheets_();var config=getConfig_();if(!config.testMode)throw new Error('Test Mode must be Yes.');var recipient='';for(var i=0;i<config.testAllowlist.length;i++){if(config.testAllowlist[i]&&config.testAllowlist[i]!==NJCWWA.SENDER_EMAIL){recipient=config.testAllowlist[i];break;}}if(!recipient)recipient=config.testAllowlist[0];assertTestRecipientAllowed_(recipient,config);var existing=findFirstRecord_(NJCWWA.SHEETS.QUEUE,function(record){return safeString_(record['Queue ID']).indexOf(NJCWWA.TEST_PREFIX)===0&&['queued','scheduled'].indexOf(safeString_(record['Send Status']).toLowerCase())!==-1;});if(existing)return existing.record;var stamp=Utilities.formatDate(new Date(),config.timeZone,'yyyyMMdd-HHmmss');var queueId=NJCWWA.TEST_PREFIX+'Q-'+stamp;var campaignId=NJCWWA.TEST_PREFIX+'CAMPAIGN-'+stamp;var testRecord={'Queue ID':queueId,'Campaign ID':campaignId,'Employer ID':NJCWWA.TEST_PREFIX+'EMPLOYER','Contact ID':NJCWWA.TEST_PREFIX+'CONTACT','Company Name':'NJCWWA Pipeline Test Employer','Contact Name':'Test Contact','Email':recipient,'Worksite County':'Middlesex','Job Family':'MIG/GMAW Welder','Template ID':'TPL-INITIAL','Subject':'[NJCWWA TEST '+stamp+'] Employer reply pipeline test','Scheduled Date':new Date(),'Scheduled Time':'8:30 AM','Touch Number':1,'Priority':'Urgent','Approval Status':'Approved','Send Status':'Queued','Reply Received':'No','Stop Sequence':'No','Error / Notes':'Controlled allowlisted test. Remove with removeNJCWWATestData().'};appendRecord_(NJCWWA.SHEETS.QUEUE,testRecord);return testRecord;}
function sendOnePipelineTest(){var started=new Date();return withScriptLock_(function(){assertAllianceAccount_();var config=getConfig_();if(!config.testMode)throw new Error('Test Mode must be Yes.');var testRecord=createTestQueueRecord();assertTestRecipientAllowed_(testRecord['Email'],config);var entry=findFirstRecord_(NJCWWA.SHEETS.QUEUE,function(record){return safeString_(record['Queue ID'])===safeString_(testRecord['Queue ID']);});if(!entry)throw new Error('Test queue record could not be found after creation.');var body=['This is a controlled NJCWWA end-to-end pipeline test.','','Please reply in this same email thread with this sample employer response:','','We are hiring 3 entry-level MIG welders in Middlesex County on second shift at $24-$28 per hour. AWS D1.1 is preferred. Please call Joe Smith at 732-555-0100. Start date November 15, 2026.','','The system should stop follow-ups, preserve the reply, create a lead, and create a job opportunity.','','No live employer campaign was started by this test.'].join('\n');var sent=sendRawMessage_(testRecord['Email'],testRecord['Subject'],body);var sentAt=new Date();updateRecordRow_(NJCWWA.SHEETS.QUEUE,entry.rowNumber,{'Send Status':'Sent','Sent At':sentAt,'Gmail Thread ID':sent.threadId||'','Gmail Message ID':sent.id||''});logEmailActivity_({timestamp:sentAt,queueId:testRecord['Queue ID'],campaignId:testRecord['Campaign ID'],employerId:testRecord['Employer ID'],contactId:testRecord['Contact ID'],email:testRecord['Email'],eventType:'Sent',threadId:sent.threadId||'',messageId:sent.id||'',details:'Touch 1 | Controlled Pipeline Test'});logAutomation_('sendOnePipelineTest','Completed',1,1,1,'',secondsSince_(started),'Allowlisted recipient: '+testRecord['Email']);return{recipient:testRecord['Email'],queueId:testRecord['Queue ID'],campaignId:testRecord['Campaign ID'],messageId:sent.id||'',threadId:sent.threadId||''};});}
function processSyntheticPipelineTestReply(){assertAllianceAccount_();var entry=findFirstRecord_(NJCWWA.SHEETS.QUEUE,function(record){return safeString_(record['Queue ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});if(!entry){createTestQueueRecord();entry=findFirstRecord_(NJCWWA.SHEETS.QUEUE,function(record){return safeString_(record['Queue ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});}var fakeThread=safeString_(entry.record['Gmail Thread ID'])||NJCWWA.TEST_PREFIX+'THREAD';var fakeMessage=NJCWWA.TEST_PREFIX+'REPLY-'+Date.now();return processEmployerReply_({messageId:fakeMessage,threadId:fakeThread,internalDate:String(Date.now()),headers:{from:'NJCWWA Test Employer <pipeline-test@example.com>',subject:'Re: '+safeString_(entry.record['Subject'])},from:'pipeline-test@example.com',subject:'Re: '+safeString_(entry.record['Subject']),originalBody:'We are hiring 3 entry-level MIG welders in Middlesex County on second shift at $24-$28 per hour. AWS D1.1 is preferred. Please call Joe Smith at 732-555-0100. Start date November 15, 2026.',queueEntries:[entry]});}
function processSyntheticUnsubscribeTest(){assertAllianceAccount_();var queueRecord={'Queue ID':NJCWWA.TEST_PREFIX+'UNSUB-Q','Campaign ID':NJCWWA.TEST_PREFIX+'UNSUB-CAMPAIGN','Employer ID':NJCWWA.TEST_PREFIX+'UNSUB-EMPLOYER','Contact ID':NJCWWA.TEST_PREFIX+'UNSUB-CONTACT','Company Name':'NJCWWA Unsubscribe Test Employer','Contact Name':'Unsubscribe Test','Email':'unsubscribe-test@example.com','Worksite County':'Unknown','Job Family':'General Welder','Send Status':'Sent','Reply Received':'No','Stop Sequence':'No','Gmail Thread ID':NJCWWA.TEST_PREFIX+'UNSUB-THREAD'};appendRecord_(NJCWWA.SHEETS.QUEUE,queueRecord);var entry=findFirstRecord_(NJCWWA.SHEETS.QUEUE,function(record){return safeString_(record['Queue ID'])===queueRecord['Queue ID'];});return processEmployerReply_({messageId:NJCWWA.TEST_PREFIX+'UNSUB-REPLY-'+Date.now(),threadId:queueRecord['Gmail Thread ID'],internalDate:String(Date.now()),headers:{from:'unsubscribe-test@example.com',subject:'Re: NJCWWA'},from:'unsubscribe-test@example.com',subject:'Re: NJCWWA',originalBody:'UNSUBSCRIBE. Please remove me from future outreach.',queueEntries:[entry]});}
function verifyPipelineTestResults(){assertAllianceAccount_();var replies=findRecords_(NJCWWA.SHEETS.REPLIES,function(record){return safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});var leads=findRecords_(NJCWWA.SHEETS.LEADS,function(record){return safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});var opportunities=findRecords_(NJCWWA.SHEETS.OPPORTUNITIES,function(record){return safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});var stopped=findRecords_(NJCWWA.SHEETS.QUEUE,function(record){return safeString_(record['Queue ID']).indexOf(NJCWWA.TEST_PREFIX)===0&&yes_(record['Reply Received'])&&yes_(record['Stop Sequence']);});var suppressions=findRecords_(NJCWWA.SHEETS.SUPPRESSIONS,function(record){return safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0||normalizeEmail_(record['Email'])==='unsubscribe-test@example.com';});var pass=replies.length>0&&leads.length>0&&opportunities.length>0&&stopped.length>0;var result={replies:replies.length,leads:leads.length,opportunities:opportunities.length,stoppedSequences:stopped.length,testSuppressions:suppressions.length,result:pass?'PASS':'NOT COMPLETE'};console.log(JSON.stringify(result,null,2));return result;}
function removeNJCWWATestData(){assertAllianceAccount_();var deleted={};deleted.queue=deleteRecords_(NJCWWA.SHEETS.QUEUE,function(record){return safeString_(record['Queue ID']).indexOf(NJCWWA.TEST_PREFIX)===0||safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});deleted.activity=deleteRecords_(NJCWWA.SHEETS.ACTIVITY,function(record){return safeString_(record['Queue ID']).indexOf(NJCWWA.TEST_PREFIX)===0||safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0||safeString_(record['Gmail Message ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});deleted.replies=deleteRecords_(NJCWWA.SHEETS.REPLIES,function(record){return safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});deleted.leads=deleteRecords_(NJCWWA.SHEETS.LEADS,function(record){return safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});deleted.opportunities=deleteRecords_(NJCWWA.SHEETS.OPPORTUNITIES,function(record){return safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});deleted.followUps=deleteRecords_(NJCWWA.SHEETS.FOLLOW_UPS,function(record){return safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0;});deleted.suppressions=deleteRecords_(NJCWWA.SHEETS.SUPPRESSIONS,function(record){return safeString_(record['Employer ID']).indexOf(NJCWWA.TEST_PREFIX)===0||normalizeEmail_(record['Email'])==='unsubscribe-test@example.com';});console.log(JSON.stringify(deleted,null,2));return deleted;}
