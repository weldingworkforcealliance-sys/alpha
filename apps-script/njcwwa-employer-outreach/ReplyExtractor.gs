/** Structured extraction from employer reply text. Original reply content remains authoritative. */
function extractReplyInformation_(body,queueRecord){var text=String(body||'');var lower=text.toLowerCase();var info={city:'',zip:'',county:'',countySource:'',jobTypes:[],openings:'',processes:[],experience:'',certifications:[],shift:'',payText:'',payMin:'',payMax:'',payType:'',benefits:'',hiringDate:'',nextStep:'Review reply and confirm missing details',hiringContact:'',phone:'',alternateEmail:'',entryLevelStatus:'Unknown',internshipStatus:'Unknown',apprenticeshipStatus:'Unknown',additionalInformation:'',confidence:0.45};extractCounty_(text,queueRecord,info);extractCityZip_(text,info);extractOpenings_(text,info);extractJobTypes_(lower,info);extractProcesses_(lower,info);extractCareerPath_(lower,info);extractExperience_(text,lower,info);extractCertifications_(text,info);extractShiftPayBenefits_(text,lower,info);extractContactTimingAndAction_(text,lower,info);var summary=[];if(info.alternateEmail)summary.push('Alternate email: '+info.alternateEmail);if(!info.county)summary.push('Worksite county not resolved');if(!info.openings)summary.push('Number of openings not supplied');if(!info.jobTypes.length)summary.push('Job type not resolved');info.additionalInformation=summary.join('; ');info.confidence=Math.min(0.98,Math.round(info.confidence*100)/100);return info;}
function extractCounty_(text,queueRecord,info){var counties=['Atlantic','Bergen','Burlington','Camden','Cape May','Cumberland','Essex','Gloucester','Hudson','Hunterdon','Mercer','Middlesex','Monmouth','Morris','Ocean','Passaic','Salem','Somerset','Sussex','Union','Warren'];for(var i=0;i<counties.length;i++){if(new RegExp('\\b'+escapeRegExp_(counties[i])+'(?:\\s+County)?\\b','i').test(text)){info.county=counties[i];info.countySource='Employer Reply';info.confidence+=0.12;return;}}var fallback=safeString_(queueRecord&&queueRecord['Worksite County']);if(fallback&&fallback.toLowerCase()!=='unknown'){info.county=fallback;info.countySource='Campaign Record';info.confidence+=0.03;}}
function extractCityZip_(text,info){var zipMatch=text.match(/\b\d{5}(?:-\d{4})?\b/);if(zipMatch){info.zip=zipMatch[0];info.confidence+=0.04;}var patterns=[/(?:in|at our|our)\s+([A-Z][A-Za-z.' -]{2,30})\s*(?:,\s*NJ|location|facility|shop|plant)/,/([A-Z][A-Za-z.' -]{2,30}),\s*NJ\b/];for(var i=0;i<patterns.length;i++){var match=text.match(patterns[i]);if(match){info.city=match[1].trim();info.confidence+=0.05;return;}}}
function extractOpenings_(text,info){var words={one:1,two:2,three:3,four:4,five:5,six:6,seven:7,eight:8,nine:9,ten:10,several:''};var match=text.match(/\b(\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|several)\s+(?:openings?|positions?|welders?|fabricators?|ironworkers?|helpers?|interns?|apprentices?)/i);if(!match)match=text.match(/(?:need|hiring|hire|seeking|looking for)\s+(\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|several)\b/i);if(match){var raw=match[1].toLowerCase();info.openings=/^\d+$/.test(raw)?Number(raw):words[raw];if(info.openings)info.confidence+=0.09;}}
function extractJobTypes_(lower,info){var rules=[['MIG/GMAW Welder',/\bmig\b|\bgmaw\b/],['TIG/GTAW Welder',/\btig\b|\bgtaw\b/],['Stick/SMAW Welder',/\bstick\b|\bsmaw\b/],['Flux-Core/FCAW Welder',/flux[- ]?core|\bfcaw\b/],['Pipe Welder',/pipe welder|pipe welding/],['Structural Welder',/structural welder|structural welding/],['Welder/Fabricator',/welder\s*\/\s*fabricator|welder[- ]fabricator/],['Metal Fabricator',/metal fabricator|fabrication technician|fabricator/],['Ironworker',/ironworker|iron worker/],['Steel Erector',/steel erector|steel erection/],['Shop Helper',/shop helper|welding helper/],['CNC Operator',/cnc operator|cnc machinist/],['Plasma-Table Operator',/plasma table|plasma operator/],['Welding Inspector',/welding inspector|cwi/],['General Welder',/\bwelder(s)?\b|\bwelding\b/]];rules.forEach(function(rule){if(rule[1].test(lower)&&info.jobTypes.indexOf(rule[0])===-1)info.jobTypes.push(rule[0]);});if(info.jobTypes.length)info.confidence+=0.08;}
function extractProcesses_(lower,info){var rules=[['GMAW/MIG',/\bmig\b|\bgmaw\b/],['GTAW/TIG',/\btig\b|\bgtaw\b/],['SMAW/Stick',/\bstick\b|\bsmaw\b/],['FCAW/Flux-Core',/flux[- ]?core|\bfcaw\b/],['Brazing',/\bbrazing\b/],['Plasma Cutting',/plasma cut/]];rules.forEach(function(rule){if(rule[1].test(lower))info.processes.push(rule[0]);});}
function extractCareerPath_(lower,info){if(/entry[ -]?level|recent graduate|new graduate|will train|training provided|no experience/.test(lower))info.entryLevelStatus='Yes';else if(/experienced only|no entry[ -]?level|minimum\s+\d+\s+years/.test(lower))info.entryLevelStatus='No';if(/intern(ship)?|student placement|summer student/.test(lower))info.internshipStatus=/no internships?|not offering internships?/.test(lower)?'No':'Yes';if(/apprentice(ship)?|work[- ]based learning|co-?op/.test(lower))info.apprenticeshipStatus=/no apprenticeships?/.test(lower)?'No':'Yes';}
function extractExperience_(text,lower,info){var match=text.match(/(?:minimum of\s*)?(\d+)\+?\s*(?:-|to\s*\d+\s*)?years?\s+(?:of\s+)?experience/i);if(match)info.experience=match[0];else if(/no experience|required training provided|will train/.test(lower))info.experience='No prior experience required / training indicated';}
function extractCertifications_(text,info){var patterns=[/AWS\s*D1\.1/ig,/AWS\s*D1\.5/ig,/AWS\s*D17\.1/ig,/OSHA\s*(?:10|30)/ig,/NCCER/ig,/CWI/ig,/6G/ig,/3G/ig,/4G/ig,/CDL/ig];patterns.forEach(function(pattern){var matches=text.match(pattern)||[];matches.forEach(function(value){if(info.certifications.indexOf(value)===-1)info.certifications.push(value);});});}
function extractShiftPayBenefits_(text,lower,info){var shiftMatch=text.match(/\b(first|second|third|1st|2nd|3rd|day|night|evening|overnight)\s+shift\b/i);if(shiftMatch)info.shift=shiftMatch[0];var payMatch=text.match(/\$\s*([0-9]{1,3}(?:\.[0-9]{1,2})?)\s*(?:-|to|–)\s*\$?\s*([0-9]{1,3}(?:\.[0-9]{1,2})?)\s*(?:per\s+)?(hour|hr|year|annually)?/i);if(!payMatch)payMatch=text.match(/\$\s*([0-9]{1,3}(?:\.[0-9]{1,2})?)\s*(?:per\s+)?(hour|hr|year|annually)/i);if(payMatch){info.payText=payMatch[0];info.payMin=Number(payMatch[1]);if(payMatch[2]&&/^\d/.test(payMatch[2]))info.payMax=Number(payMatch[2]);else info.payMax=info.payMin;var unit=String(payMatch[3]||payMatch[2]||'').toLowerCase();info.payType=/year|annual/.test(unit)?'Annual':'Hourly';info.confidence+=0.06;}var benefits=[];['health insurance','dental','vision','401(k)','401k','paid time off','PTO','paid holidays','retirement'].forEach(function(benefit){if(lower.indexOf(benefit.toLowerCase())!==-1)benefits.push(benefit);});info.benefits=benefits.join('; ');}
function extractContactTimingAndAction_(text,lower,info){var phone=text.match(/(?:\+?1[\s.-]?)?(?:\(\d{3}\)|\d{3})[\s.-]\d{3}[\s.-]\d{4}/);if(phone)info.phone=phone[0];var emails=text.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/ig)||[];if(emails.length)info.alternateEmail=normalizeEmail_(emails[0]);var dateMatch=text.match(/\b(?:january|february|march|april|may|june|july|august|september|october|november|december)(?:\s+\d{1,2})?(?:,?\s+20\d{2})?\b|\b(?:next week|next month|next quarter|this winter|this spring|this summer|this fall|immediately|as soon as possible)\b/i);if(dateMatch)info.hiringDate=dateMatch[0];if(/call (?:me|us)|give (?:me|us) a call/i.test(text))info.nextStep='Call employer';else if(/send (?:me|us) (?:resumes?|candidates?)/i.test(text))info.nextStep='Send candidate information';else if(/schedule (?:a )?(?:call|meeting|visit)/i.test(text))info.nextStep='Schedule meeting';else if(/apply (?:at|through|online)|application/i.test(text))info.nextStep='Review application instructions';var contactMatch=text.match(/(?:contact|ask for|speak with|call)\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)?)/);if(contactMatch)info.hiringContact=contactMatch[1];}
