# Supabase Configuration
# Copy this file to your local environment and supply the values for the target deployment.
# Do not commit secret or service-role keys.

# Public Supabase project URL, for example:
# https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public/publishable Supabase key for browser clients.
# DO NOT use the service-role key or any secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
